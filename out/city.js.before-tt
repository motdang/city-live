    else if (o.mark === 'text') { b = [x - 2, y - h / 2 - 3, x + w + 3, y + h / 2 + 3]; tx = x; }
    else if (o.mark === 'dot') { b = [x - 5, y - h / 2 - 3, x + 9 + w + 3, y + h / 2 + 3]; tx = x + 9; }
