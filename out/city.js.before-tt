    c.font = f; c.lineJoin = 'round'; c.lineWidth = 4; c.strokeStyle = halo; c.fillStyle = o.col; c.textBaseline = 'middle';
    if (o.mark === 'dot') { c.beginPath(); c.arc(x + 1, y, 4, 0, 6.2832); c.stroke(); c.fill(); }
