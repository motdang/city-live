    ctx.fillStyle = ink; ctx.textAlign = 'left'; ctx.fillText(nm, b[0] + 23, b[1] + h / 2 + 0.5);
    PHITS.push({ b: b, lat: d[2], lng: d[3], S: d[4] === 2 ? 22000 : d[4] ? 12000 : null });
  });
  ctx.restore();
}

/* ------------------------------------------------------------ the engine's hits */
var TIER_COL = { exact: '#ffffff', thesaurus: '#ffb347', loose: '#ff7eb6', partial: '#8fb3ff' };
function drawHits(t) {
  if (!hits) return;
  ctx.fillStyle = document.body.classList.contains('day') ? 'rgba(236,230,216,.62)' : 'rgba(4,7,11,.62)';
  ctx.fillRect(0, 0, W, H);
  var el = t - hitsAt;
  for (var i = 0; i < hits.length; i++) {
    var h = hits[i], at = REDUCED ? 0 : i * 18; if (el < at) break;
    var p = px(h.lat, h.lng), a = Math.min(1, (el - at) / 500);
    var col = TIER_COL[h.tier] || '#ffb347', dim = h.gone ? 0.25 : 1;
    ctx.globalAlpha = dim;
    if (a < 1) { ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(p[0], p[1], 4 + (1 - a) * 26, 0, 6.2832); ctx.stroke(); }
    ctx.fillStyle = col; ctx.beginPath(); ctx.arc(p[0], p[1], h.rank < 10 ? 5 : 3, 0, 6.2832); ctx.fill();
    if (h.open === true) { ctx.strokeStyle = '#7fd8a4'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(p[0], p[1], 8, 0, 6.2832); ctx.stroke(); }
    if (h.rank < 3 && a >= 1) {
      ctx.font = '600 12px Sarabun, system-ui, sans-serif'; ctx.fillStyle = document.body.classList.contains('day') ? '#111' : '#fff';
      ctx.fillText((h.rank + 1) + ' ' + h.name, p[0] + 9, p[1] + 4);
    }
    ctx.globalAlpha = 1;
  }
}

/* ------------------------------------------------------------ the words around the map */
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
function bi(th, en) { return '<span class="bi"><span class="th">' + th + '</span><span class="en">' + en + '</span></span>'; }
function n(x) { return Number(x).toLocaleString('en-US'); }
function clock() {
  var t = now(), d = bkk(t);
  document.getElementById('clock').textContent = hhmm(t);
  document.getElementById('day').innerHTML = bi(DAY_TH[d.getUTCDay()] + ' ' + d.getUTCDate() + ' ' + MON_TH[d.getUTCMonth()],
    DAY_EN[d.getUTCDay()].slice(0, 3) + ' ' + d.getUTCDate() + ' ' + MON_EN[d.getUTCMonth()]);
}
function row(k, html) { return '<div class="row"><span class="k">' + k + '</span><span class="v">' + html + '</span></div>'; }
function spark(vals, lim) {
  var w = 120, h = 22, mx = Math.max(lim || 0, Math.max.apply(null, vals)) || 1, mn = Math.min.apply(null, vals);
  mn = Math.min(mn, 0);
  var pts = vals.map(function (v, i) { return (i / (vals.length - 1) * w).toFixed(1) + ',' + (h - (v - mn) / (mx - mn) * h).toFixed(1); }).join(' ');
  var ly = lim ? (h - (lim - mn) / (mx - mn) * h).toFixed(1) : null;
  return '<svg width="' + w + '" height="' + h + '" style="vertical-align:middle;margin-left:6px">' +
    (ly ? '<line x1="0" x2="' + w + '" y1="' + ly + '" y2="' + ly + '" stroke="#ff7b72" stroke-dasharray="3 3" stroke-width="1"/>' : '') +
    '<polyline fill="none" stroke="#5fb3d6" stroke-width="1.5" points="' + pts + '"/></svg>';
}
function readings() {
  var t = now(), out = '';
  if (!lamps) document.getElementById('lit').innerHTML = bi('กำลังจุดไฟ…', 'lighting the lamps…');
  else document.getElementById('lit').innerHTML =
    '<b>' + n(lamps.lit) + '</b> / ' + n(lamps.n) + ' ' + bi('ร้านเปิดอยู่', 'open now') +
    '<div class="sub" style="font-size:12px;color:var(--mute)">' + bi(n(P.count) + ' ที่ · จุดไม่มีไฟ = ไม่รู้เวลาเปิด', n(P.count) + ' places · unlit: hours not held') + '</div>';

  /* sky */
  var st = sunTimes(t), alt = sunAlt(t, view.lat, view.lng);
  var sky = alt > 0 ? bi('พระอาทิตย์สูง ' + Math.round(alt) + '°', 'sun ' + Math.round(alt) + '° up') :
                      bi('ฟ้ามืด', 'sun ' + Math.round(-alt) + '° below');
  sky += '<small>ขึ้น rise ' + (st[0] ? hhmm(st[0]) : '–') + ' · ตก set ' + (st[1] ? hhmm(st[1]) : '–') + '</small>';
  out += row('SKY', sky);

  /* rain + temperature */
  var w = wxNow();
  if (w) {
    var line = w.inRange ? (w.mm > 0
      ? bi('ฝน ' + w.mm + ' มม. ชั่วโมงนี้ (โอกาส ' + w.prob + '%)', 'rain ' + w.mm + ' mm this hour (' + w.prob + '% chance)')
      : bi('โอกาสฝน ' + w.prob + '% ชั่วโมงนี้', w.prob + '% chance of rain this hour'))
      : bi('พยากรณ์ไปไม่ถึงชั่วโมงนี้', 'forecast does not reach this hour');
    if (!simOffset) line += '<small>' + w.city.temp + '°C · ชื้น humidity ' + w.city.humidity + '% · วัดเมื่อ observed ' + w.city.observed.slice(11) + '</small>';
    out += row('RAIN', line);
  }

  /* traffic, in the rush bands only */
  var hr = bkk(t).getUTCHours(), band = hr >= 7 && hr < 9 ? 'am' : hr >= 16 && hr < 19 ? 'pm' : null;
  if (band && G) out += row('ROAD', bi('ชั่วโมงเร่งด่วน' + (band === 'am' ? 'เช้า' : 'เย็น') + ' · ช่องสีแดง = ถนนช้า', (band === 'am' ? 'morning' : 'evening') + ' rush: red cells are slow') +
    '<small>ค่าเฉลี่ยทั้งปี 2025 จาก TomTom ไม่ใช่รถติดวันนี้ · TomTom 2025 average for this band, not today\'s jams</small>');

  /* air */
  var a = airNow();
  if (a && a.band) out += row('AIR', '<span style="color:' + a.band.colour + '">●</span> PM2.5 ' + a.pm25 + ' µg/m³ · ' + bi(a.band.th, a.band.en) +
    '<small>แบบจำลอง CAMS ไม่ใช่เครื่องวัดริมถนน · CAMS model, not a street monitor</small>');

  /* the Ping */
  var ping = LV.ping && LV.ping.stations && LV.ping.stations.filter(function (s) { return s.id === 'P.1'; })[0];
  if (ping) {
    var vals = (ping.hours || []).slice(-96).map(function (h) { return h[1]; });
    out += row('PING', bi('แม่น้ำปิง สะพานนวรัฐ ' + ping.level + ' ม.', 'the Ping at Nawarat Bridge, ' + ping.level + ' m') +
      (vals.length > 3 ? spark(vals, ping.limit) : '') +
      '<small>ระดับเตือน alert at ' + ping.limit + ' m · ' + ping.observed.replace('T', ' ') + ' · เส้นแม่น้ำบนแผนที่กว้างตามระดับ · the river on the map is drawn to this level</small>');
  }

  /* moon */
  var sk = LV.sky && LV.sky.days && LV.sky.days[ymd(t)];
  if (sk && sk.moon) {
    var mo = sk.moon;
    out += row('MOON', bi('พระจันทร์ ' + mo.thai_label_th + (mo.wan_phra ? ' · วันพระ' : ''),
      'moon ' + Math.round(mo.illum * 100) + '% lit, ' + mo.thai_label_en + (mo.wan_phra ? ', a wan phra' : '')));
  }

  /* on now */
  var ev = LV.events && LV.events.events;
  if (ev) {
    var tn = t, onNow = [], next = [];
    ev.forEach(function (e) {
      if (e.all_day || !e.start) return;
      var s = Date.parse(e.start.replace(' ', 'T') + '+07:00'), en = e.end ? Date.parse(e.end.replace(' ', 'T') + '+07:00') : s + 2 * 3600e3;
      if (s <= tn && tn < en) onNow.push(e); else if (s > tn && s - tn < 6 * 3600e3) next.push([s, e]);
    });
    next.sort(function (x, y) { return x[0] - y[0]; });
    var lines = onNow.slice(0, 3).map(function (e) { return '<b>' + esc(e.title) + '</b>' + (e.venue_name ? ' · ' + esc(e.venue_name) : ''); });
    if (!lines.length && next.length) lines = next.slice(0, 2).map(function (x) { return hhmm(x[0]) + ' ' + esc(x[1].title) + (x[1].venue_name ? ' · ' + esc(x[1].venue_name) : ''); });
    if (lines.length) out += row(onNow.length ? 'NOW' : 'NEXT', lines.join('<br>') +
      '<small><a href="/events.html">' + (onNow.length ? 'กำลังมีงาน · on now' : 'งานถัดไป · coming up') + ' →</a></small>');
  }
  document.getElementById('rows').innerHTML = out;
}
function legend() {
  var day = document.body.classList.contains('day'), h = '';
  KIND_ORDER.forEach(function (k) { h += '<span data-g="' + k + '"' + (KON.indexOf(k) >= 0 ? ' class="on"' : '') + '><i style="background:' + GROUPS[k][day ? 1 : 0] + '"></i>' + GROUPS[k][2] + '<span class="en"> ' + GROUPS[k][3] + '</span></span>'; });
  document.getElementById('legend').innerHTML = h;
}

function hint(on) { var h = document.getElementById('hint'); if (h && !on) h.classList.add('gone'); }
/* ------------------------------------------------------------ tapping a lamp */
var tip = document.getElementById('tip');
function showTip(x, y) {
  tip.style.display = 'none';
  hint(false);
  var best = null, bd = 18 * 18;
  for (var q = 0; q < PHITS.length; q++) {
    var pb = PHITS[q].b; if (x < pb[0] || x > pb[2] || y < pb[1] || y > pb[3]) continue;
    zoomTo(PHITS[q].lat, PHITS[q].lng, PHITS[q].S || homeFor(PHITS[q].lat)); return 'zoom';
  }
  for (var q = 0; q < LHITS.length; q++) {
    var hb = LHITS[q].b; if (x < hb[0] || x > hb[2] || y < hb[1] || y > hb[3]) continue;
    var hh = LHITS[q].hit;
    if (hh.d) { best = { d: hh.d }; break; }
    zoomTo(hh.lat, hh.lng, Math.max(view.S * 2.2, SHOW_AT[3] * 1.2)); return 'zoom';
  }
  if (!lamps) return;
  if (!best && hits) hits.forEach(function (h) { var p = px(h.lat, h.lng), d = (p[0] - x) * (p[0] - x) + (p[1] - y) * (p[1] - y); if (d < bd) { bd = d; best = { hit: h }; } });
  if (!best) DRAWN.forEach(function (m) { var d = (m.x - x) * (m.x - x) + (m.y - y) * (m.y - y); if (d < bd) { bd = d; best = { d: m }; } });
  if (!best) return;
  var html;
  if (best.hit) {
    var h = best.hit;
    html = '<b>' + esc(h.name) + '</b>' + (h.nameEn ? '<span class="en">' + esc(h.nameEn) + '</span>' : '') +
      '<div class="st" style="color:' + (TIER_COL[h.tier] || '#ffb347') + '">#' + (h.rank + 1) + ' · ' + h.tier + ' · score ' + h.score + ' · ' + h.confidence + '</div>' +
      '<a href="' + h.url + '">หน้าร้าน · the page →</a>';
  } else {
    var mk = best.d; x = mk.x; y = mk.y;
    if (mk.lamp != null && !NAMES) {
      tip.innerHTML = '…'; tip.style.display = 'block'; tip.style.left = x + 12 + 'px'; tip.style.top = y + 12 + 'px';
      if (!showTip.loading) { showTip.loading = true; j('data/names.json').then(function (d) { NAMES = d; dirty = true; showTip(x, y); }); }
      return;
    }
    var L = mk.lamp != null ? NAMES[mk.lamp] : KD[mk.kind].names[mk.i], sc = mk.lamp != null ? P.sched[mk.lamp] : KD[mk.kind].sched[mk.i];
    var m = mow(now()), o = sc >= 0 && isOpen(sc, m), k = sc >= 0 ? nextChange(sc, m) : null;
    var when = k == null ? '' : hhmm(now() + k * 6e4);
    var st = sc < 0 ? '<div class="st">' + bi(GROUPS[mk.g][2], GROUPS[mk.g][3]) + '</div>'
      : '<div class="st ' + (o ? 'open' : 'shut') + '">' + (o ? 'เปิดอยู่ · open' : 'ปิดอยู่ · shut') + (when ? ' — ' + (o ? 'ปิด closes ' : 'เปิด opens ') + when : '') + '</div>';
    var la = mk.lamp != null ? P.lat[mk.lamp] : KD[mk.kind].lat[mk.i], lo = mk.lamp != null ? P.lng[mk.lamp] : KD[mk.kind].lng[mk.i];
    html = '<b>' + esc(L[0]) + '</b>' + (L[1] ? '<span class="en">' + esc(L[1]) + '</span>' : '') + st +
      '<a href="/' + L[2] + '.html" target="_top">หน้าร้าน · the page →</a>' +
      (TOOL ? '<a href="https://www.google.com/maps/dir/?api=1&destination=' + la.toFixed(6) + ',' + lo.toFixed(6) + '" target="_blank" rel="noopener">นำทาง · directions →</a>' : '');
  }
  tip.innerHTML = html; tip.style.display = 'block';
  var tw = tip.offsetWidth, th = tip.offsetHeight;
  tip.style.left = Math.max(8, Math.min(W - tw - 8, x + 12)) + 'px';
  tip.style.top = Math.max(8, Math.min(H - th - 8, y + 12)) + 'px';
}

/* ------------------------------------------------------------ the tool's bar
   where the view is (the nearest ย่าน or town), what is open in it by kind, a scale */
function toolbar() {
  var el = document.getElementById('tbar'); if (!el || !lamps) return;
  var L = lang(), c = unpx(W / 2, H / 2), area = null, ad = 1e9;
  if (LABELS) LABELS.forEach(function (r) {
    if (r.k !== 'zone' && r.k !== 'town') return;
    var d = Math.hypot(r.lat - c[0], (r.lng - c[1]) * COS); if (d < ad) { ad = d; area = r; }
  });
  var where = area && ad < 0.035 ? (L === 'en' ? area.en : area.th) : c[0] > 19.45 ? (L === 'en' ? 'Chiang Rai' : 'เชียงราย') : (L === 'en' ? 'Chiang Mai' : 'เชียงใหม่');
  var cnt = {}, tot = 0, on = KON.filter(function (k) { return KD[k] && KD[k].lat; }), m = mow(now()), i;
  if (!on.length) {
    for (i = 0; i < lamps.n; i++) if (lamps.open[i] && inView(P.lat[i], P.lng[i], 0)) { var g = P.groups[P.g[i]]; cnt[g] = (cnt[g] || 0) + 1; tot++; }
  } else on.forEach(function (k) {
    var d = KD[k]; for (var i = 0; i < d.n; i++) if (inView(d.lat[i], d.lng[i], 0)) { cnt[k] = (cnt[k] || 0) + 1; tot++; }
  });
  var top = Object.keys(cnt).sort(function (a, b) { return cnt[b] - cnt[a]; }).slice(0, 4).map(function (g) {
    return '<span><i style="background:' + GROUPS[g][1] + '"></i>' + (L === 'en' ? GROUPS[g][3] : GROUPS[g][2]) + ' ' + n(cnt[g]) + '</span>';
  }).join('');
  var what = on.length ? (L === 'en' ? ' places in view' : ' แห่งในภาพนี้') : (L === 'en' ? ' open in view · ' + hhmm(now()) : ' เปิดอยู่ในภาพนี้ · ' + hhmm(now()));
  el.querySelector('.w').textContent = where;
  el.querySelector('.n').innerHTML = '<b>' + n(tot) + '</b>' + esc(what);
  el.querySelector('.k').innerHTML = top;
  /* scale: the longest round distance under 110 px */
  var mpp = 111320 / view.S, steps = [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000], s = steps[0];
  steps.forEach(function (v) { if (v / mpp <= 110) s = v; });
  var sb = document.getElementById('scale');
  if (sb) { sb.style.width = Math.round(s / mpp) + 'px'; sb.textContent = s >= 1000 ? s / 1000 + ' km' : s + ' m'; }
}
/* where am I: the browser's own location, drawn as a blue dot */
function locate() {
  var el = document.querySelector('#tbar .n');
  if (!navigator.geolocation) return;
  navigator.geolocation.getCurrentPosition(function (p) {
    ME = { lat: p.coords.latitude, lng: p.coords.longitude, acc: p.coords.accuracy };
    if (ME.lat < 16.6 || ME.lat > 21 || ME.lng < 96.8 || ME.lng > 101.2) { if (el) el.textContent = lang() === 'en' ? 'You are outside this map' : 'คุณอยู่นอกแผนที่นี้'; return; }
    zoomTo(ME.lat, ME.lng, Math.max(view.S, 22000));
  }, function () { if (el) el.textContent = lang() === 'en' ? 'Location not shared' : 'ไม่ได้แชร์ตำแหน่ง'; }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
}
function drawMe() {
  var p = px(ME.lat, ME.lng), r = Math.max(8, ME.acc / (111320 / view.S));
  ctx.fillStyle = 'rgba(26,115,232,.14)'; ctx.beginPath(); ctx.arc(p[0], p[1], r, 0, 6.2832); ctx.fill();
  ctx.fillStyle = '#1a73e8'; ctx.strokeStyle = '#fff'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(p[0], p[1], 7, 0, 6.2832); ctx.stroke(); ctx.fill();
}

/* ------------------------------------------------------------ pan, zoom, pinch
   Michael, 2026-10-02: hands should "feel the same as google maps". So the same
   set: drag to pan with a fling at the end, pinch zooms about the fingers, double
   tap zooms in, a two-finger tap zooms out, double-tap-and-drag zooms on one
   finger, ctrl/⌘ + wheel (and a trackpad pinch) zooms about the pointer. Inside
   the front page the map takes two fingers and the page keeps one, as an embedded
   Google map does, and says so the first time a single finger tries. */
var MINS = 150, MAXS = 60000;
function clampView() {
  view.S = Math.max(MINS, Math.min(MAXS, view.S));
  view.lat = Math.max(16.6, Math.min(21, view.lat)); view.lng = Math.max(96.8, Math.min(101.2, view.lng));
}
/* put the ground point ll under screen point (x, y) at scale S */
function pinTo(ll, x, y, S) {
  view.S = Math.max(MINS, Math.min(MAXS, S));
  view.lng = ll[1] - (x - W / 2) / (view.S * COS); view.lat = ll[0] + (y - H / 2) / view.S;
  clampView(); dirty = true;
}
function quiet() {
  tip.style.display = 'none'; hint(false); anim = null; fling = null;
  document.querySelectorAll('#where .btn').forEach(function (b) { b.classList.remove('on'); });
}
function zoomAt(x, y, f) {
  var ll = unpx(x, y), S = Math.max(MINS, Math.min(MAXS, view.S * f));
  zoomTo(ll[0] + (y - H / 2) / S, ll[1] - (x - W / 2) / (S * COS), S);
}
/* fling: the pan carries on after the finger lifts and slows to a stop */
var vel = [];
function track(x, y) { var t = performance.now(); vel.push([t, x, y]); while (vel.length > 2 && t - vel[0][0] > 100) vel.shift(); }
function release() {
  if (REDUCED || vel.length < 2) return;
  var a = vel[0], b = vel[vel.length - 1], dt = b[0] - a[0];
  if (dt <= 0 || performance.now() - b[0] > 60) return;
  var vx = (b[1] - a[1]) / dt, vy = (b[2] - a[2]) / dt;
  if (Math.hypot(vx, vy) < 0.25) return;
  fling = { vx: vx, vy: vy, t: performance.now() };
}
function stepFling(t) {
  if (!fling) return;
  var dt = Math.min(40, t - fling.t); fling.t = t;
  var decay = Math.exp(-dt / 320);
  view.lng -= fling.vx * dt / (view.S * COS); view.lat += fling.vy * dt / view.S;
  fling.vx *= decay; fling.vy *= decay; clampView(); dirty = true;
  if (Math.hypot(fling.vx, fling.vy) < 0.02) fling = null;
}
/* the two-finger notice, as an embedded Google map gives it */
var coop = document.createElement('div'); coop.id = 'coop'; document.body.appendChild(coop);
function coopSay(kind) {
  var mac = /Mac|iPhone|iPad/.test(navigator.platform || '');
  coop.innerHTML = kind === 'wheel'
    ? bi(mac ? 'กด ⌘ ค้างแล้วเลื่อนเพื่อซูม' : 'กด Ctrl ค้างแล้วเลื่อนเพื่อซูม', mac ? 'Use ⌘ + scroll to zoom the map' : 'Use Ctrl + scroll to zoom the map')
    : bi('แตะแผนที่เพื่อใช้งาน', 'Tap the map to use it');
  coop.classList.add('on'); clearTimeout(coopSay.t);
  coopSay.t = setTimeout(function () { coop.classList.remove('on'); }, 1400);
}
function coopHide() { clearTimeout(coopSay.t); coop.classList.remove('on'); }

/* taps: one shows a card or follows a name; a second landing within 300 ms zooms in */
var lastTap = null;
function isQuick(x, y) { return !!(lastTap && performance.now() - lastTap.t < 300 && Math.hypot(x - lastTap.x, y - lastTap.y) < 30); }
function tapAt(x, y, quick) {
  var t = performance.now();
  if (coopOn()) { setTool(true); lastTap = null; return; }
  if (quick && lastTap) {
    var was = lastTap; lastTap = null;
    if (!was.zoomed) { tip.style.display = 'none'; zoomAt(x, y, 2); }
    return;
  }
  lastTap = { t: t, x: x, y: y, zoomed: showTip(x, y) === 'zoom' };
}

/* ---- touch ---- */
var T = null;   // {n, x0, y0, t0, moved, ll, d0, S0, quick, scroll}
function tlist(e) { var a = []; for (var i = 0; i < e.touches.length; i++) a.push([e.touches[i].clientX, e.touches[i].clientY]); return a; }
function mid(a) { return [(a[0][0] + a[1][0]) / 2, (a[0][1] + a[1][1]) / 2]; }
function dist(a) { return Math.hypot(a[0][0] - a[1][0], a[0][1] - a[1][1]); }
function startOne(x, y, quick) {
  T = { n: 1, x0: x, y0: y, t0: performance.now(), moved: false, ll: unpx(x, y), S0: view.S, quick: quick };
  vel = []; track(x, y);
}
function startTwo(a) {
  var m = mid(a);
  T = { n: 2, x0: m[0], y0: m[1], t0: T && T.n === 2 ? T.t0 : performance.now(), moved: T ? T.moved : false,
        ll: unpx(m[0], m[1]), d0: Math.max(1, dist(a)), S0: view.S };
  vel = []; track(m[0], m[1]);
}
cv.addEventListener('touchstart', function (e) {
  var a = tlist(e); fling = null; anim = null;
  if (a.length >= 2) { e.preventDefault(); coopHide(); setTool(true); startTwo(a); gest = true; quiet(); return; }
  /* a finger landing just after a tap, near it: double-tap-and-drag zooms */
  var quick = isQuick(a[0][0], a[0][1]);
  if (quick) e.preventDefault();
  startOne(a[0][0], a[0][1], quick);
  if (!coopOn() || quick) gest = true;
}, { passive: false });
cv.addEventListener('touchmove', function (e) {
  if (!T) return;
  var a = tlist(e);
  if (T.n === 2 && a.length >= 2) {
    e.preventDefault();
    var m = mid(a), d = dist(a);
    if (!T.moved && (Math.abs(d - T.d0) > 8 || Math.hypot(m[0] - T.x0, m[1] - T.y0) > 8)) { T.moved = true; quiet(); }
    if (T.moved) { pinTo(T.ll, m[0], m[1], T.S0 * d / T.d0); track(m[0], m[1]); }
    return;
  }
  if (T.n !== 1 || a.length !== 1) return;
  var x = a[0][0], y = a[0][1];
  if (!T.moved && Math.hypot(x - T.x0, y - T.y0) > 8) T.moved = true;
  if (!T.moved) return;
  if (T.quick) {                                 // up = out, down = in, about where the taps fell
    e.preventDefault(); lastTap = null; quiet();
    pinTo(T.ll, T.x0, T.y0, T.S0 * Math.exp((y - T.y0) * 0.012));
    return;
  }
  if (coopOn()) { if (!T.scroll) { T.scroll = true; coopSay('touch'); } return; }   // the page scrolls
  e.preventDefault(); quiet();
  pinTo(T.ll, x, y, view.S); track(x, y);
}, { passive: false });
function touchEnd(e) {
  if (!T) return;
  var a = tlist(e), was = T, quick = e.type === 'touchend' && performance.now() - was.t0 < 300;
  if (was.n === 2) {
    if (a.length >= 2) { startTwo(a); return; }  // a third finger came and went
    if (!was.moved && quick && e.type === 'touchend') {   // two-finger tap: out
      e.preventDefault(); T = null; gest = null; zoomAt(was.x0, was.y0, 0.5); return;
    }
    if (a.length === 1 && !coopOn()) { startOne(a[0][0], a[0][1], false); T.moved = true; return; }
    T = null; gest = null; if (was.moved) { release(); dirty = true; }
    return;
  }
  T = null; gest = null;
  if (e.type !== 'touchend') return;
  if (!was.moved) { e.preventDefault(); tapAt(was.x0, was.y0, was.quick); return; }
  if (!was.quick && !coopOn()) release();
  dirty = true;
}
cv.addEventListener('touchend', touchEnd, { passive: false });
cv.addEventListener('touchcancel', touchEnd);

/* ---- mouse and pen ---- */
var M = null;
cv.addEventListener('pointerdown', function (e) {
  if (e.pointerType === 'touch' || e.button !== 0) return;
  cv.setPointerCapture(e.pointerId); fling = null; anim = null;
  M = { x0: e.clientX, y0: e.clientY, ll: unpx(e.clientX, e.clientY), moved: false, quick: isQuick(e.clientX, e.clientY) }; vel = []; track(e.clientX, e.clientY);
  gest = true; cv.classList.add('drag');
});
cv.addEventListener('pointermove', function (e) {
  if (!M || e.pointerType === 'touch') return;
  if (!M.moved && Math.hypot(e.clientX - M.x0, e.clientY - M.y0) > 4) { M.moved = true; quiet(); setTool(true); }
  if (M.moved) { pinTo(M.ll, e.clientX, e.clientY, view.S); track(e.clientX, e.clientY); }
});
function mouseEnd(e) {
  if (!M || e.pointerType === 'touch') return;
  var was = M; M = null; gest = null; cv.classList.remove('drag');
  if (e.type !== 'pointerup') return;
  if (!was.moved) { tapAt(was.x0, was.y0, was.quick); return; }
  release(); dirty = true;
}
cv.addEventListener('pointerup', mouseEnd);
cv.addEventListener('pointercancel', mouseEnd);
cv.addEventListener('wheel', function (e) {
  if (coopOn() && !e.ctrlKey && !e.metaKey) { coopSay('wheel'); return; }
  setTool(true);
  e.preventDefault(); anim = null; fling = null;
  var dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
  var f = Math.exp(-dy * (e.ctrlKey ? 0.01 : 0.0022));   // a trackpad pinch arrives as ctrl + small deltas
  pinTo(unpx(e.clientX, e.clientY), e.clientX, e.clientY, view.S * f);
  tip.style.display = 'none'; hint(false);
}, { passive: false });

/* ------------------------------------------------------------ size */
function size() {
  W = innerWidth; H = innerHeight; if (!W || !H) return;
  [cv, base].forEach(function (c) { c.width = W * DPR; c.height = H * DPR; });
  cv.style.width = W + 'px'; cv.style.height = H + 'px'; dirty = true;
  if (view.S < 100) go('cm');
}
addEventListener('resize', size);

/* ------------------------------------------------------------ controls */
document.querySelectorAll('#where .btn').forEach(function (b) { b.addEventListener('click', function () { go(b.dataset.go); }); });
var dayBtn = document.getElementById('dayBtn');
dayBtn.addEventListener('click', function () {
  fast = !fast; dayBtn.classList.toggle('on', fast); document.getElementById('fast').classList.toggle('on', fast);
  if (!fast) { simOffset = AT ? simOffset : 0; lastMow = -2; }
  dirty = true;
});

var fold = document.getElementById('fold'), readEl = document.getElementById('read');
function setFold(f) { readEl.classList.toggle('folded', f); fold.setAttribute('aria-expanded', String(!f)); fold.textContent = f ? 'ขยาย · more' : 'ย่อ · fold'; }
fold.addEventListener('click', function () { setFold(!readEl.classList.contains('folded')); });
if (innerWidth < 640) setFold(true);

/* ------------------------------------------------------------ load, in the order it is seen */
function j(u) { return fetch(u).then(function (r) { if (!r.ok) throw new Error(u + ' ' + r.status); return r.json(); }); }
function soft(u, key) { return j(u).then(function (d) { LV[key] = d; dirty = true; readings(); }, function () { }); }

size(); go('cm'); clock(); readings(); requestAnimationFrame(frame);

/* 1 — the lamps (~40 kB): the city lights up */
j('data/lamps.json').then(function (d) {
  P = d;
  var N = P.lamps, f = P.p;
  P.lat = new Float64Array(N); P.lng = new Float64Array(N); P.g = new Uint8Array(N); P.sched = new Int16Array(N);
  for (var i = 0; i < N; i++) {
    P.lat[i] = P.base[0] + f[i * 4] / P.q; P.lng[i] = P.base[1] + f[i * 4 + 1] / P.q;
    P.g[i] = f[i * 4 + 2]; P.sched[i] = f[i * 4 + 3];
  }
  lamps = { n: N, open: new Uint8Array(N), lit: 0 };
  igniteAt = performance.now(); relight(); legend();
  j('data/kinds.json').then(function (d) { KN = d; chips(); }, function () { });
  KON.forEach(loadKind);
  if (/engine/.test(location.hash)) window.ENGINE && ENGINE.open();

  /* 2 — what is read live, small first */
  soft(LIVE + 'data/weather.json', 'weather'); soft(LIVE + 'data/air.json', 'air'); soft(LIVE + 'data/ping.json', 'ping');
  /* 3 — the ground under the lamps */
  j('data/ground.json').then(function (g) { G = g; dirty = true; }, function () { });
  j('data/roads.json').then(function (r) { R = r; dirty = true; }, function () { });
  j('data/labels.json').then(function (d) { LABELS = d; dirty = true; }, function () { });
  j('data/land.json').then(function (d) { LAND = prepLand(d); dirty = true; }, function () { });
  soft(LIVE + 'data/sky.json', 'sky'); soft(LIVE + 'data/events.json', 'events');
}).catch(function (e) { document.getElementById('lit').textContent = 'โหลดไม่ขึ้น · the city did not load: ' + e.message; });

/* refresh the perishable files every ten minutes */
setInterval(function () {
  Promise.all([soft(LIVE + 'data/weather.json', 'weather'), soft(LIVE + 'data/air.json', 'air'), soft(LIVE + 'data/ping.json', 'ping')])
    .then(function () { dirty = true; readings(); });
}, 600e3);
setInterval(function () { var d = document.body.classList.contains('day'); if (d !== legend.d) { legend.d = d; legend(); } }, 2000);

/* the part of the screen the panels leave open, when the engine is out */
function openBox() {
  var box = { l: 0, r: W, t: 0, b: H }, en = document.getElementById('engine');
  if (!en.classList.contains('open')) return box;
  if (W > 640) box.r = Math.max(200, W - en.offsetWidth);
  else { box.t = document.getElementById('top').getBoundingClientRect().bottom; box.b = Math.max(box.t + 80, H - en.offsetHeight); }
  return box;
}
var crossEl = document.getElementById('crosshair');
setInterval(function () {
  if (!crossEl.classList.contains('on')) return;
  var b = openBox(); crossEl.style.left = ((b.l + b.r) / 2) + 'px'; crossEl.style.top = ((b.t + b.b) / 2) + 'px';
}, 250);

/* ------------------------------------------------------------ what engine.js may touch */
window.CITY = {
  names: function () { return LHITS; },
  view: function () { return view; },
  places: function () { return P; },
  lamps: function () { return lamps; },
  center: function () { var b = openBox(); return unpx((b.l + b.r) / 2, (b.t + b.b) / 2); },
  simulated: function () { return Math.abs(simOffset) > 120e3; },
  openAtLabel: function () { var m = mow(now()); return ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'][Math.floor(m / 1440)] + ' ' + hhmm(now()); },
  showHits: function (h) { hits = h; hitsAt = performance.now(); tip.style.display = 'none'; },
  dimHits: function (keep) { if (hits) hits.forEach(function (h) { h.gone = !keep(h); }); },
  clearHits: function () { hits = null; },
  fit: function (list) {
    if (!list.length) return;
    /* fit the province holding most of the hits; the rest stay drawn */
    var north = list.filter(function (h) { return h.lat > 19.45; });
    list = north.length * 2 > list.length ? north : list.filter(function (h) { return h.lat <= 19.45; });
    var la = list.map(function (h) { return h.lat; }).sort(function (a, b) { return a - b; });
    var ln = list.map(function (h) { return h.lng; }).sort(function (a, b) { return a - b; });
    var q = function (a, p) { return a[Math.floor((a.length - 1) * p)]; };
    var s = q(la, 0.1), nn = q(la, 0.9), w = q(ln, 0.1), e = q(ln, 0.9), box = openBox();
    var bw = box.r - box.l, bh = Math.max(80, box.b - box.t);
    view.S = Math.max(150, Math.min(30000, Math.min(bw / ((e - w) * COS + 0.004), bh / (nn - s + 0.004)) * 0.85));
    var cx = (box.l + box.r) / 2, cy = (box.t + box.b) / 2;
    view.lng = (w + e) / 2 - (cx - W / 2) / (view.S * COS);
    view.lat = (s + nn) / 2 + (cy - H / 2) / view.S;
    dirty = true;
  }
};
})();
