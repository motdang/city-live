  if (view.S < 1500) { ctx.restore(); return; }
  var box = [10, band[0] + 6, right - 4, H - band[1] - 8], mx = (box[0] + box[2]) / 2, my = (box[1] + box[3]) / 2;
  if (box[3] - box[1] < 80) { ctx.restore(); return; }
  var towns = (LABELS || []).filter(function (r) { return r.k === 'town'; }).map(function (r) { return [r.th, r.en, r.lat, r.lng, 2]; });
  var placed = [[W - 112, cy - 30, W, cy + 52]];                // the north arrow and the scale
  ctx.font = '700 12.5px "Sarabun", system-ui, sans-serif'; ctx.textBaseline = 'middle';
  DEST.concat(towns).sort(function (a, b) { return a[4] - b[4]; }).forEach(function (d) {
    if (placed.length >= 8) return;
    var p = px(d[2], d[3]); if (p[0] > box[0] && p[0] < box[2] && p[1] > box[1] && p[1] < box[3]) return;
