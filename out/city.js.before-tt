  var day = document.body.classList.contains('day') || TOOL, band = clearBand(), right = W - (EMBED ? 64 : 12);
  var ink = day ? '#1b2128' : '#f3eee2', panel = day ? 'rgba(255,255,255,.92)' : 'rgba(10,15,22,.82)', L = lang();
  /* the north arrow */
  var cx = W - 32, cy = EMBED ? band[0] + 30 : H - 110;            // the full page keeps its buttons top right
  ctx.save();
