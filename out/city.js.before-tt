      else if (r.k === 'water') put(p[0], p[1], t, { size: 12.5, weight: 600, italic: true, col: WATER, hit: hit, geo: true });
      else if (r.k === 'wood') put(p[0], p[1], t, { size: 14, weight: 700, italic: true, col: day ? '#2f6b2f' : '#8fcf8f', hit: hit, geo: true });
