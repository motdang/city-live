    }
    var ping = G && G.rivers.filter(function (r) { return r.en === 'Ping'; })[0]; if (!ping) return;
    var nm = L === 'en' ? 'Ping River' : 'แม่น้ำปิง', done = [];
    c.font = 'italic 700 13px "Sarabun", system-ui, sans-serif';
    var tw = c.measureText(nm).width;
    ping.lines.forEach(function (ln) {
      for (var i = 2; i < ln.length - 2; i += 3) {
        var p = px(ln[i][0], ln[i][1]); if (p[0] < 60 || p[0] > right - 60 || p[1] < band[0] + 30 || p[1] > H - band[1] - 30) continue;
        if (done.some(function (q) { return Math.hypot(q[0] - p[0], q[1] - p[1]) < 260; })) continue;
        var p0 = px(ln[i - 2][0], ln[i - 2][1]), p1 = px(ln[i + 2][0], ln[i + 2][1]), ang = Math.atan2(p1[1] - p0[1], p1[0] - p0[0]);
        if (ang > Math.PI / 2) ang -= Math.PI; else if (ang < -Math.PI / 2) ang += Math.PI;
        var ox = Math.cos(ang + Math.PI / 2) * 12, oy = Math.sin(ang + Math.PI / 2) * 12, x = p[0] + ox, y = p[1] + oy;
        var hw = Math.abs(Math.cos(ang)) * tw / 2 + 6, hh = Math.abs(Math.sin(ang)) * tw / 2 + 8, bx = [x - hw, y - hh, x + hw, y + hh];
        if (!free(bx)) continue;
