      put(d.x + DOT_R + 4, d.y, nm, { size: 14, weight: 700, col: d.st === -1 ? (day ? '#3a4656' : '#d8dee8') : GROUPS[d.g][day ? 1 : 0], hit: { d: d }, mark: 'text' });
