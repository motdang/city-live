        var l = Math.hypot(b[0] - run0[0], b[1] - run0[1]), mx = (run0[0] + b[0]) / 2, my = (run0[1] + b[1]) / 2;
        if (l > bl && mx > 0 && mx < W && my > band[0] && my < H - band[1]) { bl = l; best = [run0, b]; }
