      var x = (cd[2][0][0] + cd[2][1][0]) / 2, y = (cd[2][0][1] + cd[2][1][1]) / 2;
      if (placed.some(function (p) { return p[0] === nm2 && Math.hypot(p[1] - x, p[2] - y) < 380; })) continue;
