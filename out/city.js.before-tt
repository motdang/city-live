  var right = W - (EMBED ? 64 : 4);
  function free(b) {
    if (b[0] < 4 || b[2] > right || b[1] < band[0] || b[3] > H - band[1]) return false;
    for (var i = 0; i < taken.length; i++) { var t = taken[i]; if (b[0] < t[2] && b[2] > t[0] && b[1] < t[3] && b[3] > t[1]) return false; }
    return true;
