  ctx.lineWidth = 1; ctx.strokeStyle = day ? 'rgba(0,0,0,.18)' : 'rgba(255,255,255,.2)'; ctx.stroke();
  ctx.beginPath(); ctx.moveTo(cx, cy - 15); ctx.lineTo(cx + 6, cy + 1); ctx.lineTo(cx - 6, cy + 1); ctx.closePath(); ctx.fillStyle = '#d93025'; ctx.fill();
  ctx.beginPath(); ctx.moveTo(cx, cy + 15); ctx.lineTo(cx + 6, cy + 1); ctx.lineTo(cx - 6, cy + 1); ctx.closePath(); ctx.fillStyle = day ? '#9aa3ad' : '#5d6873'; ctx.fill();
  ctx.font = '800 10px system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.lineWidth = 3; ctx.strokeStyle = panel; ctx.strokeText(L === 'en' ? 'N' : 'น', cx, cy + 1); ctx.fillStyle = ink; ctx.fillText(L === 'en' ? 'N' : 'น', cx, cy + 1);
  /* the scale (the tool has its own under the map) */
