var DEST = [
  ['เชียงใหม่', 'Chiang Mai', 18.7883, 98.9853, 0], ['เชียงราย', 'Chiang Rai', 19.9105, 99.8406, 0],
  ['ลำพูน', 'Lamphun', 18.5745, 99.0087, 1], ['ลำปาง', 'Lampang', 18.2888, 99.4909, 1],
  ['ปาย', 'Pai', 19.3583, 98.4400, 1], ['เชียงดาว', 'Chiang Dao', 19.3667, 98.9667, 1],
  ['ดอยอินทนนท์', 'Doi Inthanon', 18.5886, 98.4867, 1], ['แม่สาย', 'Mae Sai', 20.4280, 99.8830, 1],
  ['เชียงแสน', 'Chiang Saen', 20.2740, 100.0870, 1], ['พะเยา', 'Phayao', 19.1666, 99.9020, 1]
