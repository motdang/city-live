    var mpp = 111320 / view.S, steps = [100, 200, 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000], s = steps[0];
    steps.forEach(function (v) { if (v / mpp <= 90) s = v; });
    var bw = s / mpp, by = cy + 36, bx = W - 12 - bw, lab = s >= 1000 ? s / 1000 + (L === 'en' ? ' km' : ' กม.') : s + (L === 'en' ? ' m' : ' ม.');
    ctx.lineWidth = 4; ctx.strokeStyle = panel; ctx.lineCap = 'butt';
    ctx.beginPath(); ctx.moveTo(bx, by - 5); ctx.lineTo(bx, by); ctx.lineTo(bx + bw, by); ctx.lineTo(bx + bw, by - 5); ctx.stroke();
    ctx.lineWidth = 1.6; ctx.strokeStyle = ink; ctx.stroke();
    ctx.font = '700 11px system-ui, sans-serif'; ctx.textBaseline = 'bottom'; ctx.lineWidth = 3; ctx.strokeStyle = panel;
    ctx.strokeText(lab, bx + bw / 2, by - 3); ctx.fillStyle = ink; ctx.fillText(lab, bx + bw / 2, by - 3);
  }
