}
/* the frame's picture, split once into a forest mask and a relief shade */
function groundImg(key) {
  var g = GIMG[key];
  if (g) return g.ready ? g : null;
  var meta = LAND && LAND.ground && LAND.ground[key]; if (!meta) return null;
  g = GIMG[key] = { ready: false, bbox: meta.bbox, tint: {} };
  var im = new Image();
  im.onload = function () {
    var w = im.naturalWidth, h = im.naturalHeight, s = document.createElement('canvas'); s.width = w; s.height = h;
    var sc = s.getContext('2d', { willReadFrequently: true }); sc.drawImage(im, 0, 0);
    var src = sc.getImageData(0, 0, w, h).data, wood = sc.createImageData(w, h), rel = sc.createImageData(w, h);
    for (var i = 0; i < src.length; i += 4) {
      wood.data[i] = wood.data[i + 1] = wood.data[i + 2] = 255; wood.data[i + 3] = src[i] > 24 ? src[i] : 0;
      var v = src[i + 1] - 128;
      if (v < 0) { rel.data[i] = 30; rel.data[i + 1] = 42; rel.data[i + 2] = 58; rel.data[i + 3] = Math.min(255, -v * 2.2); }
      else { rel.data[i] = rel.data[i + 1] = 255; rel.data[i + 2] = 246; rel.data[i + 3] = Math.min(255, v * 1.6); }
    }
    function cv2(d) { var x = document.createElement('canvas'); x.width = w; x.height = h; x.getContext('2d').putImageData(d, 0, 0); return x; }
    g.wood = cv2(wood); g.rel = cv2(rel); g.ready = true; dirty = true;
  };
  im.src = 'data/' + meta.src;
  return null;
}
function woodTint(g, col) {
