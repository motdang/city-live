  if (a && a.pm25 > 37.5) { ctx.fillStyle = 'rgba(190,150,90,' + Math.min(0.28, (a.pm25 - 37.5) / 250) + ')'; ctx.fillRect(0, 0, W, H); }
}

/* ------------------------------------------------------------ frame */
var lastT = performance.now();
function frame(t) {
