function homeS() { var v = VIEWS[view.lat > 19.5 ? 'cr' : 'cm']; return Math.min(W, H * 1.15) / v.span; }
function homeFor(lat) { var v = VIEWS[lat > 19.5 ? 'cr' : 'cm']; return Math.min(W, H * 1.15) / v.span; }

/* the key: one chip per kind; a tap switches that kind's places on (or off again).
