        [[x - ir - 2, y - hh, x + ir + 5 + w + 3, y + hh], x + ir + 5, y, 'left'],
        [[x - ir - 8 - w, y - hh, x + ir + 2, y + hh], x - ir - 5, y, 'right'],
        [[Math.min(ic[0], x - w / 2 - 3), ic[1], Math.max(ic[2], x + w / 2 + 3), y + ir + 4 + h + 2], x, y + ir + 3 + h / 2, 'center'],
        [[Math.min(ic[0], x - w / 2 - 3), y - ir - 4 - h - 2, Math.max(ic[2], x + w / 2 + 3), ic[3]], x, y - ir - 3 - h / 2, 'center']];
      var got = null;
