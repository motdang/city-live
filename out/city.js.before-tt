  var x = document.createElement('canvas'); x.width = g.wood.width; x.height = g.wood.height;
  var xc = x.getContext('2d'); xc.drawImage(g.wood, 0, 0); xc.globalCompositeOperation = 'source-in'; xc.fillStyle = col; xc.fillRect(0, 0, x.width, x.height);
  return (g.tint[col] = x);
}
function drawLand(c, day) {
  if (!LAND) return;
  var P0 = palette(day), wide = view.S < 2500;
  /* forest, then the relief over it */
  var key = wide ? 'north' : view.lat > 19.4 ? 'cr' : 'cm', g = groundImg(key);
  if (!wide && !g) g = groundImg('north');
  if (g) {
